{
  "name": "deploy-dev",
  "description": "Docker compose setup for dev environment",
  "type": "module",
  "scripts": {
    "dev": "process-compose up -f process-compose.yaml -e .env.dev",
    "dev:monitoring": "process-compose up -f process-compose.yaml -f process-compose.monitoring.yaml -e .env.dev",
    "dev:monitoring-only": "process-compose up -f process-compose.monitoring.yaml -e .env.dev"
  },
  "dependencies": {
    "@saflib/dev-tools": "*"
  }
}
