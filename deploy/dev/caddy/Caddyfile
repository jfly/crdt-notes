import common.Caddyfile 

{$PROTOCOL}://{$DOMAIN} {
	reverse_proxy localhost:5173
}

{$PROTOCOL}://app.{$DOMAIN} {
	reverse_proxy localhost:5173
}

{$PROTOCOL}://auth.{$DOMAIN} {
	reverse_proxy localhost:5173
}

{$PROTOCOL}://notes.{$DOMAIN} {
	reverse_proxy {$NOTES_SERVICE_HTTP_HOST}
}

