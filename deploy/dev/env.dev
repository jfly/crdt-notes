# @saflib/env
ALLOW_DB_CREATION=true
CLIENT_SUBDOMAINS=,auth,app,grafana
DEPLOYMENT_NAME=development
DOMAIN=notes.localhost
DOMAIN_REDIRECTS=dne.docker.localhost
MOCK_INTEGRATIONS=true
NODE_ENV=development
PROTOCOL=http
SERVICE_SUBDOMAINS=identity
TZ=UTC

# @saflib/identity-grpc
IDENTITY_SERVICE_GRPC_PORT=50051

# @saflib/identity-http
IDENTITY_SERVICE_ADMIN_EMAILS=admin@local.net
IDENTITY_SERVICE_DISABLE_RATE_LIMITING=
IDENTITY_SERVICE_HTTP_HOST=localhost:3000
IDENTITY_SERVICE_GRPC_HOST=localhost:3001

# @saflib/email
NODEMAILER_TRANSPORT_CONFIG=

# notes-service
NOTES_SERVICE_HTTP_HOST=localhost:3002

# monitoring
NODE_EXPORTER_HOST=localhost:3003
GRAFANA_HOST=127.0.0.1:3004
PROMETHEUS_HOST=localhost:3005
LOKI_HOSTNAME=localhost
LOKI_PORT=3006